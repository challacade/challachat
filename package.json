{
  "name": "challachat",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript version of the ChallaChat standalone app: local YouTube chat capture + overlay server",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx app/http/server.ts",
    "build": "tsc -p .",
    "start": "node dist/http/server.js",
    "start:system": "bash ./scripts/start-on-system.sh",
    "start:system:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/windows/start-on-system.ps1",
    "typecheck": "tsc -p . --noEmit",
    "build:portable": "bash ./scripts/build-portable.sh",
    "build:portable:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/windows/build-portable.ps1",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/windows/build-installer.ps1"
  },
  "dependencies": {
    "express": "^4.19.2",
    "music-metadata": "^11.10.3",
    "puppeteer": "^24.9.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "postject": "^1.0.0-alpha.6",
    "rcedit": "^4.0.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1"
  }
}
