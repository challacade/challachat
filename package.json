{
  "name": "challachat",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript version of the ChallaChat standalone app: local YouTube chat scraper + overlay server",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx src/http/server.ts",
    "build": "tsc -p .",
    "start": "node dist/http/server.js",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2",
    "puppeteer": "^22.15.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
