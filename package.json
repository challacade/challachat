{
  "name": "challachat",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript version of the ChallaChat standalone app: local YouTube chat capture + overlay server",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx app/http/server.ts",
    "build": "tsc -p .",
    "start": "node dist/http/server.js",
    "start:system": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/windows/start-on-system.ps1",
    "typecheck": "tsc -p . --noEmit",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/windows/build-portable.ps1",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/windows/build-installer.ps1"
  },
  "dependencies": {
    "express": "^4.19.2",
    "puppeteer": "^24.9.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "postject": "^1.0.0-alpha.6",
    "rcedit": "^4.0.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1"
  },
  "sea": {
    "main": "dist/http/server.js",
    "output": "sea-prep.blob",
    "disableExperimentalSEAWarning": true,
    "useCodeCache": true,
    "assets": {
      "overlay/index.html": "overlay/index.html",
      "overlay/app.js": "overlay/app.js",
      "overlay/styles.css": "overlay/styles.css",
      "overlay/favicon.ico": "overlay/favicon.ico",
      "overlay/sounds/donation.mp3": "overlay/sounds/donation.mp3",
      "overlay/sounds/member.mp3": "overlay/sounds/member.mp3",
      "overlay/sounds/message.mp3": "overlay/sounds/message.mp3"
    }
  }
}
