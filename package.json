{
  "name": "challachat",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript version of the ChallaChat standalone app: local YouTube chat scraper + overlay server",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/http/server.ts",
    "build": "tsc -p .",
    "bundle": "webpack --config webpack/webpack.config.js",
    "start": "node dist/http/server.js",
    "start:system": "powershell -NoProfile -ExecutionPolicy Bypass -File ./utils/windows/start-on-system.ps1",
    "typecheck": "tsc -p . --noEmit",
    "build:win": "npm run build && npm run bundle && npm run sea:win",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File ./utils/windows/build-portable.ps1",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./utils/windows/release.ps1",
    "sea:win": "npm run sea:generate && npm run sea:inject",
    "sea:generate": "node --experimental-sea-config webpack/sea-config.json",
    "sea:inject": "powershell -NoProfile -ExecutionPolicy Bypass -File ./utils/windows/inject-sea.ps1"
  },
  "dependencies": {
    "express": "^4.19.2",
    "puppeteer": "^24.9.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "postject": "^1.0.0-alpha.6",
    "rcedit": "^4.0.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-node-externals": "^3.0.0"
  },
  "sea": {
    "main": "dist/http/server.js",
    "output": "sea-prep.blob",
    "disableExperimentalSEAWarning": true,
    "useCodeCache": true,
    "assets": {
      "static/index.html": "static/index.html",
      "static/app.js": "static/app.js",
      "static/styles.css": "static/styles.css",
      "static/images/challachat.ico": "static/images/challachat.ico",
      "static/sounds/donation.mp3": "static/sounds/donation.mp3",
      "static/sounds/member.mp3": "static/sounds/member.mp3",
      "static/sounds/message.mp3": "static/sounds/message.mp3"
    }
  }
}
